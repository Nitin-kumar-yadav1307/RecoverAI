{
  "name": "recoverai",
  "version": "0.1.0",
  "private": true,
  "description": "RecoverAI - Autonomous Revenue Recovery Agent",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "build:domain": "pnpm --filter @recoverai/domain build",
    "test:domain": "pnpm --filter @recoverai/domain test",
    "db:generate": "pnpm --filter @recoverai/database generate",
    "db:migrate:deploy": "pnpm --filter @recoverai/database migrate:deploy",
    "db:setup": "pnpm --filter @recoverai/database setup",
    "postinstall": "pnpm db:generate"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}