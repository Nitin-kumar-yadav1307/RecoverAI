# ===== RecoverAI environment =====
# Copy to .env and fill in. Never commit .env.

# --- Database (PostgreSQL via Prisma) ---
DATABASE_URL="postgresql://recoverai:recoverai@localhost:5432/recoverai?schema=public"

# --- Redis (BullMQ scheduler/queue) ---
REDIS_URL="redis://localhost:6379"

# --- Auth / Session ---
AUTH_SECRET="change-me-to-a-long-random-string"
SESSION_SECRET="change-me-to-a-long-random-string"

# --- AI provider (LLMProvider) ---
# Primary: Groq
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
# Optional fallback: OpenAI
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
# Which provider order to attempt: "groq,openai,mock"
LLM_PROVIDER_ORDER="groq,openai,mock"
# Force mock (tests / local without keys)
LLM_FORCE_MOCK="false"

# --- Payments: Razorpay (test mode) ---
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
PAYMENT_PROVIDER="razorpay"   # "razorpay" | "mock"

# --- Messaging (email recovery outreach) ---
RESEND_API_KEY=""
# Verified sender (must be a domain verified in Resend; test sandbox uses onboarding@resend.dev)
RESEND_FROM="RecoverAI <onboarding@resend.dev>"
MESSAGING_FORCE_MOCK="false"


